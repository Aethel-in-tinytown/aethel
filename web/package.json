{
  "name": "aethel-tiny-town",
  "version": "0.29.0",
  "description": "Watch Aethel \u2014 a little pixel town, live. A TypeScript rebuild (esbuild + Preact + Phaser) of the Aethel spectator page.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e",
    "format": "prettier --write src tests e2e *.mjs *.ts index.html",
    "format:check": "prettier --check src tests e2e *.mjs *.ts index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.56.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
